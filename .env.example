# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# --- image ------------------------------------------------------------------
# Built locally by ./build-image.sh — Helpdesk ships in no official image.
HELPDESK_IMAGE=sis/frappe-helpdesk
HELPDESK_TAG=v15

# --- site -------------------------------------------------------------------
# The site name IS the Host header Frappe routes on. Use the hostname you will
# actually serve from, even in local development, or requests from the SIS by
# container name will not resolve to a site.
SITE_NAME=helpdesk.localhost

# Administrator login for the Frappe Desk. Used once for setup, then day-to-day
# access should go through SSO against the SIS instead.
ADMIN_PASSWORD=change-me-admin

# MariaDB root password. Only used at site-creation time.
DB_ROOT_PASSWORD=change-me-db-root

# Host port for the Helpdesk UI. 8093 avoids the SIS's 8092/8099.
HELPDESK_PORT=8093


# ============================================================================
# The values below are consumed by scripts/provision.py and by SIS_BACKEND.
# ============================================================================

# Where provision.py should reach this stack. Matches HELPDESK_PORT above.
FRAPPE_URL=http://localhost:8090

# Administrator API key/secret, generated in the Frappe Desk (see docs). Used
# ONLY by provision.py for one-time setup — never by the SIS.
ADMIN_API_KEY=
ADMIN_API_SECRET=

# Where Frappe POSTs the one webhook it still sends: a ticket was resolved or
# closed, so the SIS can notify the requester in-app. Must be reachable from
# inside the Frappe containers — a container name if both stacks share a
# network, a public URL otherwise — and in the SIS's ALLOWED_HOSTS.
#
# Optional. Leave both blank and provision.py creates the custom fields and
# skips the webhook; you lose the in-app notification and nothing else.
SIS_WEBHOOK_URL=http://host.docker.internal:8092/api/v1/support/webhooks/frappe/

# Shared secret used to sign webhook bodies. Must match HELPDESK_WEBHOOK_SECRET
# in the SIS environment exactly, or every delivery is rejected with a 401.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
